# API
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Redis / Celery
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

# Object storage — local MinIO (laptop / dev)
STORAGE_BACKEND=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=storytime
S3_REGION=us-east-1
S3_USE_SSL=false

# Script: stub = rules only; ollama = local open-source LLM (see docs/deploy/ollama.md)
SCRIPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
# LLM_TIMEOUT_SEC=180

# Pipeline — grandma English voice via Microsoft Edge TTS (free; worker needs internet)
TTS_PROVIDER=edge
TTS_VOICE=en-GB-SoniaNeural
# Alternatives to try: en-US-JennyNeural, en-GB-MaisieNeural
DEFAULT_TEMPLATE_ID=kids_moral_v1

# Scene images (downloaded per job into temp storage, removed after render)
IMAGE_PROVIDER=wikimedia
# IMAGE_PROVIDER=pexels
# PEXELS_API_KEY=
# IMAGE_PROVIDER=pixabay
# PIXABAY_API_KEY=
# IMAGE_PROVIDER=none
