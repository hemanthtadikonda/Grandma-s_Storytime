# EC2 / production — Amazon S3 via instance IAM role (no access keys in .env)
# Copy: cp .env.aws.example .env

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_BACKEND=aws
S3_BUCKET=your-grandma-storytime-bucket
S3_REGION=us-east-1
# Do not set S3_ENDPOINT, S3_ACCESS_KEY, or S3_SECRET_KEY — boto3 uses the EC2 instance role

SCRIPT_PROVIDER=stub
TTS_PROVIDER=edge
TTS_VOICE=en-GB-SoniaNeural
DEFAULT_TEMPLATE_ID=kids_moral_v1
