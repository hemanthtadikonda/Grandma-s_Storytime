# EC2 / production — Amazon S3 via instance IAM role (no access keys in .env)
# Copy: cp .env.aws.example .env

API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

STORAGE_BACKEND=aws
S3_BUCKET=your-grandma-storytime-bucket
S3_REGION=us-east-1
# Do not set S3_ENDPOINT, S3_ACCESS_KEY, or S3_SECRET_KEY — boto3 uses the EC2 instance role

# Install Ollama on the EC2 host, pull a model, then point the worker at it:
# OLLAMA_BASE_URL=http://host.docker.internal:11434
SCRIPT_PROVIDER=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.2:3b
TTS_PROVIDER=edge
TTS_VOICE=en-GB-SoniaNeural
DEFAULT_TEMPLATE_ID=kids_moral_v1

IMAGE_PROVIDER=wikimedia
